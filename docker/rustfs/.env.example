# Copy to .env and fill in your own values — never commit the real .env.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Generate credentials with:
#   AK="rustfsadmin$(openssl rand -hex 3)"
#   SK="$(openssl rand -base64 24)"
#
# Leaving these unset makes RustFS fall back to rustfsadmin/rustfsadmin.
# Fine for a throwaway local test, never for anything reachable by others.

RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
